---
import Placeholder from './interactive/Placeholder.tsx';
import { interactiveInfo } from '../i18n/ui';
import { useTranslations, type Lang } from '../i18n/utils';

const { id, lang } = Astro.props as { id: string; lang: Lang };
const t = useTranslations(lang);

const info = interactiveInfo[id];
const icon = info?.icon ?? '✦';
const title = info?.title[lang] ?? id;
const desc = info?.desc[lang] ?? '';

// -------------------------------------------------------------------------
// REGISTER A BUILT ISLAND  (3 steps — do all three):
//   1. import it below
//   2. add its id to the BUILT set
//   3. add a `{id === '<id>' && <Component client:visible lang={lang} />}` line
// Astro can't attach a client directive to a dynamic component variable, so
// each built id gets an explicit conditional render. Unbuilt ids fall through
// to the styled Placeholder (which shows the interactiveInfo blurb).
// -------------------------------------------------------------------------
// Import built islands here (see steps above).
import StaffExplorer from './interactive/StaffExplorer.tsx';
import RhythmTapper from './interactive/RhythmTapper.tsx';
import GuitarAnatomy from './interactive/GuitarAnatomy.tsx';
import IntervalTrainer from './interactive/IntervalTrainer.tsx';
import ScaleBuilder from './interactive/ScaleBuilder.tsx';
import TimeConductor from './interactive/TimeConductor.tsx';
import CircleSpinner from './interactive/CircleSpinner.tsx';
import ChordExplorer from './interactive/ChordExplorer.tsx';
import TunerPractice from './interactive/TunerPractice.tsx';

const BUILT = new Set<string>([
  'staff-explorer',
  'rhythm-tapper',
  'guitar-anatomy',
  'interval-trainer',
  'scale-builder',
  'time-conductor',
  'circle-spinner',
  'chord-explorer',
  'tuner-practice',
]);
const isBuilt = BUILT.has(id);
---

<div class="interactive-wrap" data-interactive={id}>
  {id === 'staff-explorer' && <StaffExplorer client:visible lang={lang} />}
  {id === 'rhythm-tapper' && <RhythmTapper client:visible lang={lang} />}
  {id === 'guitar-anatomy' && <GuitarAnatomy client:visible lang={lang} />}
  {id === 'interval-trainer' && <IntervalTrainer client:visible lang={lang} />}
  {id === 'scale-builder' && <ScaleBuilder client:visible lang={lang} />}
  {id === 'time-conductor' && <TimeConductor client:visible lang={lang} />}
  {id === 'circle-spinner' && <CircleSpinner client:visible lang={lang} />}
  {id === 'chord-explorer' && <ChordExplorer client:visible lang={lang} />}
  {id === 'tuner-practice' && <TunerPractice client:visible lang={lang} />}

  {!isBuilt && (
    <Placeholder
      icon={icon}
      title={title}
      desc={desc}
      badge={t('interactive.badge')}
      comingSoon={t('interactive.comingSoon')}
      note={t('interactive.note')}
    />
  )}
</div>
